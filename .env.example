# Select LLM provider: 'groq', 'openrouter', or 'openai' (default: groq)
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Groq API Key (required if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Concurrency level for running cases in parallel (default: 4)
CONCURRENCY=4
