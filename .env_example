# Model Provider Configuration (Model parameters MUST be <= 10B)
# Choose one provider or specify local model setup

# Option 1: Groq Free API (Recommended: Qwen 2.5 7B / Llama 3.1 8B)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_NAME=qwen-2.5-7b-instruct

# Option 2: Google Gemini API (Recommended: Gemma 2 9B)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: Local Ollama (Free local execution)
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_NAME=qwen2.5:7b

# System Environment Settings
LOG_LEVEL=INFO
DATA_DIR=./data
INPUT_DIR=./input
OUTPUT_DIR=./output
LOGGING_DIR=./logging
TRACE_FILE=./trace.jsonl
